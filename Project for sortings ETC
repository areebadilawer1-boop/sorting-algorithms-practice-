#include <iostream>
using namespace std;

int main()
{
    // array bana liya, random numbers daal diye
    int arr[6] = {7, 2, 9, 4, 1, 5};
    int n = 6;

    cout << "Original: ";
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";
    cout << endl;

    // selection sort start
    for (int i = 0; i < n - 1; i++)
    {
        int minIndex = i; // assume current index is min
        for (int j = i + 1; j < n; j++)
        {
            if (arr[j] < arr[minIndex])
            {
                minIndex = j; // new min mil gaya
            }
        }
        // swap karna pada
        int temp = arr[minIndex];
        arr[minIndex] = arr[i];
        arr[i] = temp;

        // har step print karwa diya
        cout << "step " << i + 1 << ": ";
        for (int k = 0; k < n; k++)
            cout << arr[k] << " ";
        cout << endl;
    }

    // final sorted array
    cout << "Sorted: ";
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";
    cout << endl;

    return 0;
}
